# Copy to .env (never committed) and fill in.

# docker compose: password of the local PostgreSQL
POSTGRES_PASSWORD=change-me

# Login: one admin from these two, and/or a bcrypt htpasswd file
# (htpasswd -nB <user>, or: echo -n 'password' | vartija hash-password <user>)
VARTIJA_ADMIN_USER=admin
VARTIJA_ADMIN_PASSWORD=change-me-at-least-12-chars
# VARTIJA_HTPASSWD_FILE=/etc/vartija/htpasswd

# Signs the session cookie: 32+ random characters (openssl rand -hex 32)
VARTIJA_SESSION_SECRET=

# How often every subnet is swept (Go duration, min 1m)
VARTIJA_SCAN_INTERVAL=5m

# Slack: a bot token (chat:write) and a channel the bot was invited to,
# or an incoming webhook
# VARTIJA_SLACK_BOT_TOKEN=xoxb-...
# VARTIJA_SLACK_CHANNEL=#vartija
# VARTIJA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Link in the alerts
# VARTIJA_BASE_URL=https://vartija.example.com

# Optional: MikroTik routers (api-ssl, read-only user) for subnets this
# host has no interface on, and DHCP host names
# VARTIJA_MIKROTIK_ROUTERS=core=192.168.1.1,edge=192.168.2.1:8729
# VARTIJA_MIKROTIK_USER=
# VARTIJA_MIKROTIK_PASSWORD=

# Optional: reverse DNS server and suffixes to strip from the names
# VARTIJA_DNS_SERVER=192.168.1.1
# VARTIJA_DNS_STRIP_SUFFIXES=lan,home.arpa
